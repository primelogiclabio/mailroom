<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.primelogiclab.mailroom</groupId>
        <artifactId>mailroom</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>mailroom-http-java8</artifactId>
    <name>mailroom-http-java8</name>
    <description>Shared HTTP and JSON plumbing for mailroom provider modules. A support library for provider authors, not application API. Java 8 set.</description>

    <properties>
        <shared.tests>http</shared.tests>
        <module.name>io.primelogiclab.mailroom.http</module.name>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.primelogiclab.mailroom</groupId>
            <artifactId>mailroom-core-java8</artifactId>
        </dependency>
        <!-- Streaming API only (JsonWriter, JsonValue); no Jackson type appears in this module's API. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-core</artifactId>
        </dependency>
        <!-- StubHttpServer for the engine tests; mailroom-tck never depends on this module, so there is no cycle. -->
        <dependency>
            <groupId>io.primelogiclab.mailroom</groupId>
            <artifactId>mailroom-tck-java8</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Adds shared-tests/http, the tests this module shares with its Java 21 twin. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
