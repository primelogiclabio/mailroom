<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.primelogiclab</groupId>
    <artifactId>mailroom-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>mailroom</name>
    <description>Java SMTP mailing library with connection reuse, STARTTLS/TLS and automatic retry.</description>
    <url>https://github.com/primelogiclabio/mailroom</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
        </license>
    </licenses>

    <scm>
        <url>https://github.com/primelogiclabio/mailroom</url>
        <connection>scm:git:https://github.com/primelogiclabio/mailroom.git</connection>
    </scm>

    <!--
      Two builds of the same API:
        mailroom-java8   Java 8+,  javax.mail   (Spring Boot 2, Java EE 8)
        mailroom-java21  Java 21+, jakarta.mail (Spring Boot 3, Jakarta EE 9+)
      Each module must be built with a JDK it supports; on JDK 8 build only
      mailroom-java8:  mvn -pl mailroom-java8 -am verify
    -->
    <modules>
        <module>mailroom-java8</module>
        <module>mailroom-java21</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <build>
        <pluginManagement>
            <!-- Plugin versions that still run on JDK 8. -->
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.2</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.4.2</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
