<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd"
         child.project.url.inherit.append.path="false">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.primelogiclab.mailroom</groupId>
        <artifactId>mailroom-parent</artifactId>
        <version>0.3.0</version>
        <relativePath/>
    </parent>

    <artifactId>mailroom</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>mailroom</name>
    <description>Small Java email API with pluggable provider modules: the core library, HTTP helper, test kit and provider contract tests.</description>
    <url>https://github.com/primelogiclabio/mailroom</url>

    <scm child.scm.connection.inherit.append.path="false"
         child.scm.developerConnection.inherit.append.path="false"
         child.scm.url.inherit.append.path="false">
        <connection>scm:git:https://github.com/primelogiclabio/mailroom.git</connection>
        <developerConnection>scm:git:https://github.com/primelogiclabio/mailroom.git</developerConnection>
        <url>https://github.com/primelogiclabio/mailroom</url>
    </scm>

    <issueManagement>
        <system>GitHub</system>
        <url>https://github.com/primelogiclabio/mailroom/issues</url>
    </issueManagement>

    <modules>
        <!-- The Java 21 set: no java8-set file, so mailroom-parent builds them for Java 21. -->
        <module>mailroom-core</module>
        <module>mailroom-test</module>
        <module>mailroom-http</module>
        <module>mailroom-tck</module>
        <!-- The Java 8 set: a java8-set file in each module. -->
        <module>mailroom-core-java8</module>
        <module>mailroom-http-java8</module>
        <module>mailroom-test-java8</module>
        <module>mailroom-tck-java8</module>
        <!-- Build check, never published: the two sets' public APIs match, apart from listed differences. -->
        <module>mailroom-api-check</module>
    </modules>

    <!-- Maven reads the parent before anything it declares, so these entries must be here too. -->
    <repositories>
        <repository>
            <id>primelogiclab-releases</id>
            <url>https://repo.primelogiclab.io/releases</url>
            <releases><enabled>true</enabled></releases>
            <snapshots><enabled>false</enabled></snapshots>
        </repository>
        <repository>
            <id>primelogiclab-snapshots</id>
            <url>https://repo.primelogiclab.io/snapshots</url>
            <releases><enabled>false</enabled></releases>
            <snapshots><enabled>true</enabled></snapshots>
        </repository>
    </repositories>

    <properties>
        <!-- The 2.x line: Jackson 3 needs Java 17. 2.21 is an LTS line. -->
        <jackson.version>2.21.8</jackson.version>
        <build-helper.version>3.8.0</build-helper.version>
        <dependency-plugin.version>3.10.0</dependency-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-core</artifactId>
                <version>${jackson.version}</version>
            </dependency>
            <dependency>
                <groupId>io.primelogiclab.mailroom</groupId>
                <artifactId>mailroom-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.primelogiclab.mailroom</groupId>
                <artifactId>mailroom-test</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.primelogiclab.mailroom</groupId>
                <artifactId>mailroom-http</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.primelogiclab.mailroom</groupId>
                <artifactId>mailroom-tck</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.primelogiclab.mailroom</groupId>
                <artifactId>mailroom-core-java8</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.primelogiclab.mailroom</groupId>
                <artifactId>mailroom-http-java8</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.primelogiclab.mailroom</groupId>
                <artifactId>mailroom-test-java8</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.primelogiclab.mailroom</groupId>
                <artifactId>mailroom-tck-java8</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!-- Tests both Java sets of a module pair run: shared-tests/<shared.tests>/java and /resources.
                     A module sets shared.tests and lists this plugin in its own build. -->
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>build-helper-maven-plugin</artifactId>
                    <version>${build-helper.version}</version>
                    <executions>
                        <execution>
                            <id>add-shared-tests</id>
                            <phase>generate-test-sources</phase>
                            <goals>
                                <goal>add-test-source</goal>
                            </goals>
                            <configuration>
                                <sources>
                                    <source>${project.basedir}/../shared-tests/${shared.tests}/java</source>
                                </sources>
                            </configuration>
                        </execution>
                        <execution>
                            <id>add-shared-test-resources</id>
                            <phase>generate-test-resources</phase>
                            <goals>
                                <goal>add-test-resource</goal>
                            </goals>
                            <configuration>
                                <resources>
                                    <resource>
                                        <directory>${project.basedir}/../shared-tests/${shared.tests}/resources</directory>
                                    </resource>
                                </resources>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <version>${dependency-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <!-- Test libraries for every module; versions come from mailroom-parent. -->
    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
