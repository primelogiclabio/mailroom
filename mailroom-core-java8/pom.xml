<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.primelogiclab.mailroom</groupId>
        <artifactId>mailroom</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>mailroom-core-java8</artifactId>
    <name>mailroom-core-java8</name>
    <description>The mailroom email API: the message model, sending API, router and provider SPI. Depends on the JDK only. Java 8 set.</description>

    <properties>
        <shared.tests>core</shared.tests>
        <module.name>io.primelogiclab.mailroom</module.name>
    </properties>

    <build>
        <!-- Only version.properties is filtered: it gives core its own version at runtime, jar or not. -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>io/primelogiclab/mailroom/internal/version.properties</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>io/primelogiclab/mailroom/internal/version.properties</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <!-- Adds shared-tests/core, the tests this module shares with its Java 21 twin. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
